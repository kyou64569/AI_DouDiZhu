{
  "name": "ai-doudizhu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI 斗地主 —— 接入任意 OpenAI 兼容大模型的对战/观战游戏（网页版 + 桌面版）",
  "author": "kyou64569",
  "main": "out/main.mjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc -b",
    "desktop:bundle": "esbuild desktop/main.ts --bundle --platform=node --format=esm --external:electron --outfile=out/main.mjs --log-level=warning && esbuild server/index.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=out/server.mjs --log-level=warning",
    "desktop:dev": "npm run desktop:bundle && concurrently -n web,api,desktop -c cyan,magenta,green \"vite\" \"tsx watch server/index.ts\" \"cross-env DESKTOP_DEV=1 electron .\"",
    "desktop:build": "npm run build && npm run desktop:bundle && electron-builder --win"
  },
  "build": {
    "appId": "com.kyou64569.aidoudizhu",
    "productName": "AI斗地主",
    "directories": {
      "output": "desktop-release",
      "buildResources": "desktop"
    },
    "files": [
      "out/**",
      "dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "portable": {
      "artifactName": "AI斗地主-桌面版-${version}.exe"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
